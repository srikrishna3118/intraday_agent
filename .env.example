# Angel One SmartAPI credentials
# Sign up: https://smartapi.angelbroking.com/
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Execution (paper by default)
AGENT_MODE=equity
LIVE_TRADING=false
ALLOW_SHORT=true
ALLOW_LONG=false

# Strategy: rsi_mr (default) | orb | vwap_pullback | rsi_div | ...
STRATEGY=rsi_mr

# F&O research strategy surface (paper-first, separate from equity STRATEGY)
# Live NFO orders remain blocked. Paper only.
FNO_STRATEGY=time_based_straddle
FNO_STRATEGIES=time_based_straddle,ema920_credit_spread,ema920_option_buy,premium_orb_short,expiry_vol_strangle
FNO_UNDERLYING=NIFTY
FNO_WEEKLY_ONLY=false
FNO_LOTS=1
FNO_HEDGE_WING_POINTS=200
FNO_ENTRY_TIMES=09:20
FNO_EXIT_TIME=15:10
FNO_ENTRY_CUTOFF=14:30
FNO_LEG_STOP_LOSS_PCT=20
FNO_COMBINED_STOP_LOSS_PCT=0
FNO_MAX_MARGIN_UTILIZATION_PCT=60
FNO_CHECK_INTERVAL_SEC=15
FNO_CAPITAL=200000
FNO_DEFINED_RISK_ONLY=true
FNO_MAX_POSITIONS_PER_STRATEGY=1
FNO_MAX_DAILY_LOSS=20000
FNO_BROKERAGE_PER_ORDER=20
FNO_SLIPPAGE_PCT=0.25
FNO_EMA_ENTRY_TIME=09:20
FNO_EMA_FAST=9
FNO_EMA_SLOW=21
FNO_BUY_PREMIUM_TARGET=200
FNO_BUY_STOP_PCT=20
FNO_ORB_PICK_TIME=09:16
FNO_ORB_PREMIUM_TARGET=200
FNO_ORB_RANGE_END=11:15
FNO_EXPIRY_ENTRY_TIME=11:00
FNO_EXPIRY_EXIT_TIME=14:30
FNO_EXPIRY_TAIL_PROB=0.10
FNO_EXPIRY_MIN_DISTANCE_PCT=0.4
FNO_EXPIRY_STOP_PCT=50
FNO_EXPIRY_MODEL_PATH=data/models/fno_expiry_vol.json
FNO_OPEN_POSITIONS_PATH=data/fno_open_positions.json
FNO_CAPTURE_ON_EXIT=true
FNO_CAPTURE_STRIKE_BUFFER=400
FNO_IV_SNAPSHOT_MIN=15
FNO_CANDLE_STORE_DIR=data/candles_fno

# Opening range breakout (STRATEGY=orb)
ORB_MINUTES=15
ORB_VOLUME_MULT=1.2
ORB_STOP_MODE=range
ORB_USE_RSI_EXIT=true
ORB_TARGET_R_MULT=1.5

# VWAP pullback (STRATEGY=vwap_pullback)
VWAP_PULLBACK_TOUCH_PCT=0.15
VWAP_PULLBACK_REQUIRE_SLOPE=false
VWAP_PULLBACK_SLOPE_BARS=3

# Position sizing (paper stack Jul 2026 — edge search at ₹50k)
CAPITAL_PER_TRADE=50000
MAX_QUANTITY=100
MAX_POSITIONS=2

# RSI mean-reversion (paper Tier 2 — phase sprint winner Jun 2026)
RSI_PERIOD=14
RSI_OVERBOUGHT=80          # short entries require RSI > 80
RSI_OVERSOLD=28
RSI_EXIT=50

# Symbols to skip entirely (comma-separated; empty = none)
EXCLUDED_SYMBOLS=ONGC,SBIN,BAJFINANCE

# Volume confirmation (signal candle volume > VOLUME_MA_MULT * SMA)
VOLUME_MA_LEN=20
VOLUME_MA_MULT=1.2
VOLUME_MA_MAX_MULT=2.0       # skip entries when volume > this × SMA (0 = no cap)

# Candles & schedule
CANDLE_INTERVAL=FIFTEEN_MINUTE
CANDLE_LOOKBACK=100
CANDLE_STORE_DIR=data/candles
CANDLE_STORE_MAX_AGE_HOURS=24
CANDLE_HISTORY_CHUNK_DAYS=150

# Research backtests: cache (local parquet, default) | angel | yahoo
RESEARCH_DATA_SOURCE=cache
CANDLE_CACHE_BACKEND=angel
CHECK_INTERVAL=90
SCREENER_INTERVAL_SEC=180
REGIME_REFRESH_SEC=300
API_RATE_LIMIT_PAUSE_SEC=90       # flat pause on getCandleData rate limit (position mgmt only)
API_RATE_LIMIT_PAUSE_MAX=90       # same as above = no escalation (set higher for 2x/4x steps)
API_RECOVERY_STREAK_THRESHOLD=0   # 0=off; Yahoo screener avoids bulk candle calls
API_RECOVERY_PAUSE_SEC=600
SQUARE_OFF_TIME=15:15
ENTRY_CUTOFF_TIME=13:00      # no new entries at/after this IST time (edge search: morning session)
# naive candle datetimes: utc (Angel cache/research) | ist (Yahoo screener — set when SCREENER_DATA_SOURCE=yahoo)
CANDLE_NAIVE_TZ=utc

# Risk (% move from entry price; used when USE_ATR_EXITS=false)
STOP_LOSS_PCT=1.2
TARGET_PCT=1.2
USE_ATR_EXITS=true
ATR_PERIOD=14
ATR_STOP_MULT=1.25           # edge search winner (Jul 2026); was 1.5
ATR_TARGET_MULT=50           # Sprint 4: mean exit (RSI 50); high mult disables fixed ATR target
# Exit after N bars if underwater and RSI 50 has not fired (0 = disabled; P1 research: 4–6)
TIME_STOP_BARS=0
TRAILING_STOP_ENABLED=false  # MR paper stack: off — trailing exits ~0.25% and blocks RSI 50 run
TRAILING_STOP_ATR_MULT=1.0
TRAILING_ACTIVATION_ATR_MULT=1.0
TRAILING_ACTIVATION_PCT=0.5
TRAILING_STOP_PCT=0.8
VWAP_FILTER_ENABLED=false
VWAP_EXIT_ENABLED=false
# Sprint 5: MR short fade — require price above VWAP + min extension (see RESEARCH_HANDBOOK.md)
VWAP_MR_FADE_SHORT=false
VWAP_MR_MIN_EXTENSION_PCT=0.3
# Block shorts when volume > N × 20-bar avg (0 = disabled; Sprint 5 winner: 2.0)
VOLUME_SURGE_BLOCK_MULT=2.0
# CIPLA pattern: block short when RSI > 86 and vol/MA > 1.7 (0 = disabled)
RSI_MOMENTUM_TRAP_RSI=86
RSI_MOMENTUM_TRAP_VOLR=1.7
# Upper circuit proximity guard for shorts (architecture §8)
CIRCUIT_GUARD_ENABLED=true
CIRCUIT_LIMIT_PCT=20
CIRCUIT_MIN_DISTANCE_PCT=2.0

# Classic pivot confluence — paper Tier 2 (phase sprint; sim +₹45 / 21 trades)
PIVOT_FILTER_ENABLED=true
# MR strategies: zone | proximity | both. Trend (orb, vwap_pullback, zp_dmi) uses PP half.
PIVOT_FILTER_MODE=proximity
PIVOT_TOUCH_PCT=0.35

REGIME_FILTER_ENABLED=true
VIX_MAX=18
NIFTY_REGIME_ENABLED=false
NIFTY_EMA_PERIOD=20

# ADX entry gate on rsi_mr (0 = disabled; band: ADX_MR_MIN <= adx < ADX_MR_MAX)
ADX_PERIOD=14
ADX_MR_MIN=0
ADX_MR_MAX=0

# Relative-strength mean reversion (rs_mr) — research long profile
RS_MR_MIN_DAY_CHANGE=2.0
RS_MR_MAX_DAY_CHANGE=5.0
RS_MR_PULLBACK_ATR_MIN=0.5
RS_MR_PULLBACK_ATR_MAX=1.0
RS_MR_REQUIRE_BULLISH=true

# VWAP mean reversion (vwap_mr) — fade distance from VWAP (not vwap_pullback trend)
VWAP_MR_MIN_DIST=0.8
VWAP_MR_RSI_OVERSOLD=30
VWAP_MR_USE_VWAP_TARGET=true

# Opening drive fade (open_fade) — gap-up exhaustion short, cover at VWAP
OPEN_FADE_MIN_GAP=1.5
OPEN_FADE_MIN_RSI=80
OPEN_FADE_MIN_BODY_PCT=0.3
OPEN_FADE_END_TIME=11:00
OPEN_FADE_VOLUME_MULT=1.2

# RSI divergence (rsi_div) — Pine RSI Divergence Indicator port
RSI_DIV_PERIOD=9
RSI_DIV_PIVOT_LEFT=1
RSI_DIV_PIVOT_RIGHT=3
RSI_DIV_RANGE_LOWER=5
RSI_DIV_RANGE_UPPER=60
RSI_DIV_TP_RSI=80
RSI_DIV_PLOT_BULL=true
RSI_DIV_PLOT_HIDDEN_BULL=true
RSI_DIV_PLOT_BEAR=true
RSI_DIV_PLOT_HIDDEN_BEAR=false
RSI_DIV_SL_TYPE=NONE
RSI_DIV_STOP_LOSS_PCT=5
RSI_DIV_ATR_LEN=14
RSI_DIV_ATR_MULT=3.5

# ZPayab DIY DMI confluence (zp_dmi): ADX lead + RQK/VWAP/Chandelier/MACD/volume
ZP_DMI_DI_LEN=10
ZP_DMI_ADX_LEN=5
ZP_DMI_ADX_MIN=20
ZP_RQK_H=8
ZP_RQK_R=8
ZP_RQK_X0=25
ZP_CE_LEN=22
ZP_CE_MULT=3.0
ZP_CE_USE_CLOSE=true
ZP_MACD_FAST=12
ZP_MACD_SLOW=26
ZP_MACD_SIGNAL=9
ZP_VOL_MA_LEN=20
ZP_SIGNAL_EXPIRY=3
ZP_ALTERNATE_SIGNAL=true

# ZPayab supply/demand S/R (swing pivot + ATR box) — optional zp_dmi filter
ZP_SD_FILTER_ENABLED=false
ZP_SD_SWING_LEN=10
ZP_SD_HISTORY=20
ZP_SD_BOX_WIDTH=2.5
ZP_SD_ATR_LEN=50
ZP_SD_TOUCH_PCT=0.35
# at_zone = long at demand / short at supply; avoid = skip entries into opposite zone
ZP_SD_FILTER_MODE=avoid

# Zeiierman Volume SuperTrend AI (vst_ai) — CC BY-NC-SA 4.0
VST_K=3
VST_N=10
VST_PRICE_LEN=20
VST_ST_LEN=100
VST_LEN=10
VST_FACTOR=3.0
VST_MA_SRC=WMA
VST_AI_SIGNALS=true
VST_ENTRY_MODE=both
VST_EXIT_ON_FLIP=true

# SBP Trend & Momentum (sbp_tm) — research only; do not enable in paper stack until bake-off passes
SBP_TRADE_MODE=INTRADAY
SBP_TRAIL_ATR_MULT=1.0
SBP_USE_TRAIL_EXIT=true
SBP_MOMENTUM_MIN=70

# [Quadapt] Machine Learning Trader (quadapt_ml)
# Ports: Adaptive RQ MLMA + dual-length nonlinear envelopes + order-block context + quality filter
# IMPORTANT: min_bars ≈ max(QUADAPT_WINDOW, QUADAPT_LEN1+20, ...). Set CANDLE_LOOKBACK accordingly.
# Pine defaults (120/70/200) suit 60-min+ charts.
# Research profile (15m): LEN1=30 LEN2=14 WINDOW=60 CANDLE_LOOKBACK=120 STRATEGY=quadapt_ml
# Pine defaults below suit 60m+ charts only — do not use on 15m without rescaling.
QUADAPT_LEN1=30
QUADAPT_LEN2=14
QUADAPT_WINDOW=60
QUADAPT_ATR_PERIOD=20
QUADAPT_MULT=2.0
QUADAPT_RQ_ALPHA=1.0
QUADAPT_RQ_BANDWIDTH=8.0
QUADAPT_OB_VOL_LEN=6
QUADAPT_OB_SMOOTH_LEN=9
QUADAPT_OB_MULT=1.2
QUADAPT_MIN_QUALITY=55
QUADAPT_SIGNAL_MODE=consensus

# Anti-overtrading guards (0 = disabled)
MAX_TRADES_PER_DAY=10        # hard cap on new entries per day
MAX_TRADES_PER_SYMBOL=2      # max entries per symbol per day
SYMBOL_COOLDOWN_MIN=30       # minutes before re-entering a symbol after it closes
LOSS_COOLDOWN_MIN=60         # longer cooldown after a losing exit (revenge-trade guard)
MAX_DAILY_LOSS=2000            # rupees; scale with CAPITAL_PER_TRADE (~4% at ₹50k)
MAX_DAILY_PROFIT=3000          # rupees; halt new entries once realized profit hits this

# Optional tuning
# Screener candles: angel (SmartAPI) | yahoo (yfinance, free, no Angel quota) | openchart
SCREENER_DATA_SOURCE=angel
# When the external feed is empty/unavailable: cache | angel | none
SCREENER_OPENCHART_FALLBACK=angel
# Angel getCandleData limit is 3/sec, 180/min, 5000/hr. Keep batch small + spaced.
SCREENER_DELAY_SEC=0.6
SCREENER_BATCH_SIZE=10
INSTRUMENTS_CACHE_MAX_AGE_HOURS=24

# Estimated Angel MIS all-in cost per completed trade (entry+exit). 0 = formula from notional.
ESTIMATED_COST_PER_TRADE=42

# ── Risk-based position sizing ──────────────────────────────────────────────
# RISK_PCT > 0 enables: qty = (ACCOUNT_EQUITY × RISK_PCT%) / |entry − stop|
# Requires a valid stop_price (ATR-based) to activate; falls back to CAPITAL_PER_TRADE otherwise.
# Set RISK_PCT=0 to keep legacy flat sizing (default, backward compatible).
RISK_PCT=0
ACCOUNT_EQUITY=500000

# ── Regime-adaptive strategy switching ──────────────────────────────────────
# When REGIME_ADAPTIVE=true, Nifty ADX determines the active strategy at runtime:
#   ADX >= REGIME_TREND_ADX_MIN  →  orb    (trend-following; Opening Range Breakout)
#   ADX <= REGIME_RANGE_ADX_MAX  →  rsi_mr (mean-reversion; default)
#   between the two              →  no change (keeps current STRATEGY setting)
# WARNING: ORB net −₹42k on 180d T2 — keep false until ORB bake-off passes.
# Disabled by default. REGIME_FILTER_ENABLED must also be true for ADX to be computed.
REGIME_ADAPTIVE=false
REGIME_TREND_ADX_MIN=25
REGIME_RANGE_ADX_MAX=20

# Universe: t2 (30 liquid, sim-validated) | nifty50 | nifty100 | nifty200 | nifty250 (legacy)
SCAN_UNIVERSE=t2

# Alerts (Phase 4 live prep — optional; requires TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID)
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Angel SmartStream WebSocket (live only; default REST polling)
STREAM_ENABLED=false

# Adaptive learning (rank/filter screener candidates from trade history)
LEARNING_ENABLED=false
LEARNING_MIN_TRADES=10
LEARNING_SKIP_WIN_RATE=0.40
LEARNING_SYMBOL_WEIGHT=20
LEARNING_LOOKBACK_DAYS=30

# Meta-label filter (logistic regression on journal; default off until OOS pass)
META_LABEL_ENABLED=false
META_LABEL_THRESHOLD=0.55
META_LABEL_MODEL_PATH=data/models/meta_label.joblib
